   "premiere",
   "download",
   "buy",
   "buy now",
   "exclusive",
   "official video",
   "official audio",
   "official music video",
   "lyric video",
   "music video",
   "youtube",
   "soundcloud",
   "bandcamp",
   "beatport",
   "hd",
   "hq"
  ],
  "feat_normalise": true,
  "feat_form": "feat.",
  "feat_to_artist": false,
  "extract_remixer": false,
  "remix_words": [
   "remix",
   "edit",
   "rework",
   "bootleg",
   "flip",
   "refix",
   "re-edit",
   "mashup"
  ],
  "remixer_ignore": [
   "original",
   "radio",
   "extended",
   "club",
   "dub",
   "single",
   "album",
   "short",
   "instrumental",
   "vocal",
   "acapella",
   "a",
   "cappella",
   "clean",
   "dirty",
   "explicit",
   "main",
   "full",
   "long",
   "the",
   "new",
   "official",
   "remastered",
   "video",
   "version",
   "vip"
  ],
  "overwrite_remixer": false,
  "genre_map_on": false,
  "genre_map": [
   {
    "from": "Tech-House",
    "to": "Tech House"
   },
   {
    "from": "Deep-House",
    "to": "Deep House"
   },
   {
    "from": "Progressive-House",
    "to": "Progressive House"
   },
   {
    "from": "Drum and Bass",
    "to": "Drum & Bass"
   },
   {
    "from": "Drum n Bass",
    "to": "Drum & Bass"
   },
   {
    "from": "DnB",
    "to": "Drum & Bass"
   },
   {
    "from": "Hip-Hop",
    "to": "Hip Hop"
   },
   {
    "from": "Hiphop",
    "to": "Hip Hop"
   },
   {
    "from": "Electronica",
    "to": "Electronic"
   }
  ],
  "artist_map_on": false,
  "artist_map": [],
  "artist_separators": [
   ",",
   "&",
   "/",
   "feat.",
   "feat",
   "ft.",
   "ft",
   "featuring",
   "vs.",
   "vs",
   "x",
   "and"
  ],
  "write_back": false,
  "write_fields": [
   "title",
   "artist",
   "album_artist",
   "album",
   "composer",
   "genre",
   "label",
   "remixer",
   "producer",
   "comments",
   "year"
