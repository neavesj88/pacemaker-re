{
 "defaults": {
  "trim": true,
  "title_case": false,
  "case_fields": [
   "title",
   "artist",
   "album"
  ],
  "keep_upper": [
   "DJ",
   "MC",
   "UK",
   "USA",
   "VIP",
   "EP",
   "LP",
   "TV",
   "II",
   "III",
   "IV"
  ],
  "small_words": [
   "a",
   "an",
   "the",
   "and",
   "but",
   "or",
   "nor",
   "for",
   "so",
   "yet",
   "as",
   "at",
   "by",
   "in",
   "of",
   "on",
   "to",
   "up",
   "via",
   "vs",
   "vs.",
   "with",
   "from",
   "into",
   "onto",
   "per",
   "feat",
   "feat.",
   "ft",
   "ft.",
   "featuring",
